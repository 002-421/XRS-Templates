":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Дата рождения: ","type":"text"},{"marks":[{"type":"bold"},{"attrs":{"filled":false,"hint":"дд.мм.гггг","id":"joints-luchezapyastnyi-sustav.birthdate","original":"дд.мм.гггг"},"type":"templateField"},{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"},{"attrs":{"color":"#ffff00"},"type":"highlight"}],"text":"дд.мм.гггг","type":"text"}],"type":"paragraph"},{"attrs":{"editableHighlight":{"edited":false,"id":"editable.2981510a.0","original":"Область и вид исследования: Магнитно-резонансная томография правого/левого лучезапястного сустава"},"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"spaceAfterPt":5.896,"templateOriginal":"Область и вид исследования: Магнитно-резонансная томография правого/левого лучезапястного сустава","textAlign":"justify"},"content":[{"marks":[{"type":"bold"},{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Область и вид исследования: Магнитно-резонансная томография ","type":"text"},{"marks":[{"type":"bold"},{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"},{"attrs":{"id":"editable.2981510a.0"},"type":"templateHighlight"}],"text":"правого/левого","type":"text"},{"marks":[{"type":"bold"},{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":" лучезапястного сустава","type":"text"}],"type":"paragraph"},{"type":"horizontalRule"}],"type":"reportSection"},{"attrs":{"id":"description","moduleId":"","title":"Описание"},"content":[{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"На серии МР томограмм взвешенных по Т1 и Т2 с жироподавлением в трех проекциях визуализируются кости запястья, дистальные отделы лучевой и локтевой костей.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"На серии МР томограмм взвешенных по Т1 и Т2 с жироподавлением в трех проекциях визуализируются кости запястья, дистальные отделы лучевой и локтевой костей.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Кости, образующие лучезапястный сустав, имеют обычную конфигурацию.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Кости, образующие лучезапястный сустав, имеют обычную конфигурацию.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Угол сочленения с лучевой костью в норме. Кости запястья обычной формы, связаны друг с другом, лучезапястным и карпо-метакарпальным суставами.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Угол сочленения с лучевой костью в норме. Кости запястья обычной формы, связаны друг с другом, лучезапястным и карпо-метакарпальным суставами.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Костно-травматических изменений не определяется.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Костно-травматических изменений не определяется.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"В полости сустава физиологическое количество жидкости.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"В полости сустава физиологическое количество жидкости.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Суставные поверхности имеют четкие и конгруэнтные края, нормальную толщину кортикального слоя и ширину полости сустава. Остеофиты или изменения сигнала от субхондральных отделов костей, образующих сустав, не определяются. Интенсивность МР сигнала от костного мозга не изменена.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Суставные поверхности имеют четкие и конгруэнтные края, нормальную толщину кортикального слоя и ширину полости сустава. Остеофиты или изменения сигнала от субхондральных отделов костей, образующих сустав, не определяются. Интенсивность МР сигнала от костного мозга не изменена.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Суставной диск (треугольной формы) локтевой кости имеет нормальную конфигурацию и характеристики сигнала. Межкостная мембрана предплечья также без патологических изменений.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Суставной диск (треугольной формы) локтевой кости имеет нормальную конфигурацию и характеристики сигнала. Межкостная мембрана предплечья также без патологических изменений.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Пястные кости и фаланги пальцев имеют нормальные края и интенсивность сигнала от костного мозга.","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Пястные кости и фаланги пальцев имеют нормальные края и интенсивность сигнала от костного мозга.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Мягкие ткани без патологических изменений","textAlign":"justify"},"content":[{"marks":[{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Мягкие ткани без патологических изменений","type":"text"}],"type":"paragraph"},{"type":"horizontalRule"}],"type":"reportSection"},{"attrs":{"id":"conclusion","moduleId":"","title":"Заключение"},"content":[{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"ЗАКЛЮЧЕНИЕ: МР-картина асептического некроза полулунной и ладьевидной костей (стадия некроза).","textAlign":"justify"},"content":[{"marks":[{"type":"bold"},{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"ЗАКЛЮЧЕНИЕ: МР-картина асептического некроза полулунной и ладьевидной костей (стадия некроза).","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"Трабекулярный отек лучевой, головчатой, полулунной и ладьевидной костей, нерезко выраженный синовит.","textAlign":"justify"},"content":[{"marks":[{"type":"bold"},{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"Трабекулярный отек лучевой, головчатой, полулунной и ладьевидной костей, нерезко выраженный синовит.","type":"text"}],"type":"paragraph"},{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"templateOriginal":"МР-данных о наличии патологических изменений лучезапястного сустава не выявлено.","textAlign":"justify"},"content":[{"marks":[{"type":"bold"},{"attrs":{"fontFamily":"Arial","fontSize":"14.66667px"},"type":"textStyle"}],"text":"МР-данных о наличии патологических изменений лучезапястного сустава не выявлено.","type":"text"}],"type":"paragraph"}],"type":"reportSection"},{"attrs":{"id":"signature","moduleId":"","title":"Рекомендации и подпись"},"content":[{"attrs":{"firstLineIndentPt":27.893,"fontFamily":"Arial","fontSizePt":11,"lineHeight":1.05,"spaceAfterPt":12,"spaceBeforePt":12,"templateO